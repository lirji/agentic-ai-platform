# 仅展示变量形状；真实凭据保存在被忽略的 .local/ 或外部 secrets 管理。
KNOWLEDGE_DB_URL=jdbc:mysql://127.0.0.1:43306/agentic_knowledge
KNOWLEDGE_DB_USER=agentic_app
KNOWLEDGE_DB_PASSWORD=
KNOWLEDGE_MIGRATION_USER=agentic_migrate
KNOWLEDGE_MIGRATION_PASSWORD=
KNOWLEDGE_S3_ENDPOINT=http://127.0.0.1:49000
KNOWLEDGE_S3_REGION=us-east-1
KNOWLEDGE_S3_BUCKET=agentic-ai-knowledge
KNOWLEDGE_S3_ACCESS_KEY=agentic_app
KNOWLEDGE_S3_SECRET_KEY=
IAM_ISSUER=
IAM_AUDIENCE=
IAM_TENANT_CLAIM=tenant_id
IAM_PUBLIC_KEY=file:/absolute/path/to/iam-public.pem
INTERNAL_PUBLIC_KEY=file:/absolute/path/to/internal-public.pem
INTERNAL_PRIVATE_KEY=file:/absolute/path/to/internal-private.pem
KNOWLEDGE_SERVICE_URL=http://127.0.0.1:28084
GATEWAY_PORT=28080
KNOWLEDGE_PORT=28084
GATEWAY_MANAGEMENT_PORT=29080
KNOWLEDGE_MANAGEMENT_PORT=29084
OTEL_EXPORT_ENABLED=false
# 处理开关默认关闭；本地脚本从项目私密配置注入以下设置。
KNOWLEDGE_PROCESSING_ENABLED=false
# 仅选择新PDF/DOCX任务：BLOCK_V2（默认）或STRUCTURE_V3；未知值拒绝启动。
KNOWLEDGE_STRUCTURED_PROFILE=BLOCK_V2
KNOWLEDGE_WORKER_ENABLED=false
KNOWLEDGE_WORKER_TENANT=local-dev
KNOWLEDGE_AI_ENDPOINT=http://127.0.0.1:28085
KNOWLEDGE_AI_PRIVATE_KEY=file:/absolute/path/to/knowledge-ai-private.pem
KNOWLEDGE_AI_PUBLIC_KEY=file:/absolute/path/to/knowledge-ai-public.pem
KNOWLEDGE_QDRANT_ENDPOINT=http://127.0.0.1:26333
KNOWLEDGE_QDRANT_KEY=
KNOWLEDGE_QDRANT_COLLECTION=agentic_knowledge_text_v1
KNOWLEDGE_ELASTIC_ENDPOINT=http://127.0.0.1:29200
KNOWLEDGE_ELASTIC_USER=agentic_knowledge_dev
KNOWLEDGE_ELASTIC_PASSWORD=
KNOWLEDGE_ELASTIC_INDEX=agentic-knowledge-text-v1
KNOWLEDGE_LEASE_SECONDS=60
KNOWLEDGE_HEARTBEAT_SECONDS=10
KNOWLEDGE_POLL_SECONDS=2
KNOWLEDGE_JOB_SECONDS=120
KNOWLEDGE_AI_SECONDS=45
KNOWLEDGE_INDEX_SECONDS=8

# 中央 AI 任务（与知识库独立数据库及账号）。
TASK_DB_URL=jdbc:mysql://127.0.0.1:43306/agentic_tasks
TASK_DB_USER=agentic_task_app
TASK_DB_PASSWORD=
TASK_MIGRATION_USER=agentic_task_migrate
TASK_MIGRATION_PASSWORD=
TASK_SUBMIT_PUBLIC_KEY=file:/absolute/path/to/task-submit-public.pem
TASK_WORKER_PUBLIC_KEY=file:/absolute/path/to/task-worker-public.pem
TASK_SERVICE_URL=http://127.0.0.1:28087
TASK_PORT=28087
TASK_MANAGEMENT_PORT=29087
TASK_LEASE_SECONDS=60

# S10B 分阶段开放：先停止旧 writer，再回填，保护历史读取后启用代次/更新。
KNOWLEDGE_LIFECYCLE_CREATE_ENABLED=true
KNOWLEDGE_LIFECYCLE_GENERATION_ENABLED=false
KNOWLEDGE_LIFECYCLE_UPDATES_ENABLED=false
KNOWLEDGE_LIFECYCLE_BACKFILL_ENABLED=false
KNOWLEDGE_CITATION_READER_ENABLED=false
KNOWLEDGE_CITATION_READER_PUBLIC_KEY=file:/absolute/path/to/task-knowledge-reader-public.pem
TASK_KNOWLEDGE_READER_ENABLED=false
TASK_KNOWLEDGE_READER_ENDPOINT=http://127.0.0.1:28084
TASK_KNOWLEDGE_READER_PUBLIC_KEY=file:/absolute/path/to/task-knowledge-reader-public.pem
TASK_KNOWLEDGE_READER_PRIVATE_KEY=file:/absolute/path/to/task-knowledge-reader-private.pem

# 会话拥有原始问题与可靠交接；独立库/账号，不注入 Tasks worker 私钥。
CONVERSATION_DB_URL=jdbc:mysql://127.0.0.1:43306/agentic_conversations
CONVERSATION_DB_USER=agentic_conv_app
CONVERSATION_DB_PASSWORD=
CONVERSATION_MIGRATION_USER=agentic_conv_migrate
CONVERSATION_MIGRATION_PASSWORD=
CONVERSATION_SUBMIT_PUBLIC_KEY=file:/absolute/path/to/task-submit-public.pem
CONVERSATION_SUBMIT_PRIVATE_KEY=file:/absolute/path/to/task-submit-private.pem
CONVERSATION_TASK_ENDPOINT=http://127.0.0.1:28087
CONVERSATION_SERVICE_URL=http://127.0.0.1:28088
CONVERSATION_PORT=28088
CONVERSATION_MANAGEMENT_PORT=29088
CONVERSATION_WORKER_ENABLED=false
CONVERSATION_WORKER_TENANT=local-dev
CONVERSATION_POLL_SECONDS=2

# 仅为配置键模板；按账号地域填写 HTTPS 基础地址，通过受控环境注入真实 API Key。
# CLI 不自动加载 dotenv 文件，防止无意读取其他项目凭据。
RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BATCH_SIZE=10
RAG_EMBEDDING_MAX_TEXTS=100
RAG_EMBEDDING_MAX_INPUT_BYTES=1048576
RAG_EMBEDDING_MAX_RESPONSE_BYTES=4194304
RAG_EMBEDDING_MAX_CONNECTIONS=10
RAG_EMBEDDING_DEADLINE_SECONDS=30
# 关闭时只提供原存活端点；启用后必须配置独立 Knowledge 服务验签公钥。
AI_PROCESSING_ENABLED=false
AI_SERVICE_PUBLIC_KEY=
AI_PROCESSING_MAX_CONCURRENT=2
AI_PROCESSING_DEADLINE_SECONDS=40

  "1057b886-46fc-5bd9-a1aa-dfc43785111f": {
    "questionId": "1057b886-46fc-5bd9-a1aa-dfc43785111f",
    "outcome": "SUCCEEDED",
    "result": {
      "schemaVersion": "knowledge-qa-result-v1",
      "answerability": "ANSWERED",
      "answer": "不能自动借用。当前采用显式静态份额，暂不借用空闲份额；每种资源的全部租户份额之和不得超过该服务数据库所辖全局上限，满额租户不能领取其他租户的预留容量，空闲份额不自动贡献吞吐[1]。后续若改变调度策略需独立验证[1]。",
      "citations": [
        {
          "citationId": "1",
          "documentId": "d8396ef2-4e83-4821-ae93-dbdda469adfc",
